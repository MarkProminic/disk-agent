#!/bin/bash
set -e

if [ "$1" = "remove" ]; then
    if systemctl is-active --quiet disk-agent; then
        echo "Stopping Disk Agent service..."
        systemctl stop disk-agent
    fi

    if systemctl is-enabled --quiet disk-agent; then
        echo "Disabling Disk Agent service..."
        systemctl disable disk-agent
    fi
fi

#DEBHELPER#
